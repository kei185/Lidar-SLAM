services:
    ros:
        build:
            context: .
            dockerfile: Dockerfile
            args:
                DISTRO: ${DISTRO}
                MNT_POINT: ${MNT_POINT}
        # DEVICE: ${DEVICE}
        image: my-ros:${DISTRO}
        init: true
        network_mode: host
        command:
        container_name: "${DISTRO}"
        shm_size: "10gb"
        volumes:
            - ${MNT_POINT}:/root/mnt
        devices:
            - ${DEVICE}:${DEVICE}
        ports:
            - 6080:80
